<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Launch screen: logo centered on the app background (light/dark). The rest of the
	     Info.plist is still generated from the build settings. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIImageName</key>
		<string>LaunchLogo</string>
		<key>UIColorName</key>
		<string>Background</string>
	</dict>
	<!-- Invite links: rivalrry://invite/<username> (Phase 3, until there is a domain for Universal Links). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.oliverzengerpersonalteam.rivalrry.invite</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>rivalrry</string>
			</array>
		</dict>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Scan a friend's QR code to add them.</string>
</dict>
</plist>
